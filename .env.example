# --- Wallet & Blockchain ---
VITE_WALLETCONNECT_PROJECT_ID=
VITE_DEFAULT_CHAIN=base
# NOTE: every VITE_* value is inlined into the client bundle and is therefore
# PUBLIC. Only use an RPC URL that is safe to expose (domain-restricted).
VITE_BASE_RPC_URL=

# --- OpenSea (server-side) ---
# Used by /api/nfts, which proxies OpenSea so the key never reaches the browser.
OPENSEA_API_KEY=

# Legacy: direct browser calls to OpenSea. Only for `vite dev` without a
# serverless runtime — the key WILL be published in the bundle.
# VITE_OPENSEA_API_KEY=
# VITE_OPENSEA_DIRECT=true

# --- Auth ---
# Random secret for JWT signing
JWT_SECRET=

# --- Storage (Upstash Redis) ---
# Supports both legacy Vercel KV and standard Upstash variables
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Legacy Vercel KV (if using Vercel Integration)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Admin ---
# Comma-separated addresses
ADMIN_WALLETS=
VITE_ADMIN_WALLETS=
GEMINI_API_KEY=your_api_key_here
